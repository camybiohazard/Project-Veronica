{
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Ninja",
    "cmake.configureArgs": ["-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/linux-i686.cmake"],

    // The build trees hold full copies of SDL, ImGui and xxHash sources (build-win and build each),
    // which cpptools' symbol database would otherwise parse on top of the project: ~3,200 extra files.
    // Headers they provide are still found through compile_commands.json.
    "C_Cpp.files.exclude": {
        "**/build*/**": true,
        "**/logs/**": true,
        "**/.git/**": true
    },
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
    "files.watcherExclude": {
        "**/build*/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/build*/**": true
    }
}
